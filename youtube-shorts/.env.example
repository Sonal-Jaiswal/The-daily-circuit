# Copy to youtube-shorts/.env for local runs. On GitHub Actions these come from repository secrets.
# Required to upload (`python auth.py` fills these in):
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Optional, all free tiers. Without them the script comes from the article's key facts
# and the visuals from the article's own image.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODELS=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Optional tuning
SITE_URL=https://aiblog.fun
GEMINI_VOICE=en-in-commercial-7
# edge-tts is only the fallback when Gemini speech is unavailable
TTS_VOICE=en-IN-NeerjaNeural
TTS_RATE=+8%
MAX_ARTICLE_AGE_HOURS=72
