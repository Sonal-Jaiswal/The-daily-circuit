# ─────────────────────────────────────────────────────────────────────────────
# The Daily Circuit — environment variables
# Copy to .env for local development. In production set these in Vercel (web)
# and Render/Railway (worker). Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Neon / Supabase PostgreSQL) ───────────────────────────────────
# Pooled connection string for the app (Neon: the "-pooler" host).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Direct (non-pooled) connection used only by `prisma migrate`.
DIRECT_DATABASE_URL=
# Connections per process. Keep small on Vercel; the worker can use more.
DATABASE_POOL_MAX=5
# Disposable database for integration and e2e tests (name must contain "test").
TEST_DATABASE_URL=postgresql://tdc:tdc_local_dev@localhost:54329/tdc_test

# ── Site ────────────────────────────────────────────────────────────────────
# Canonical public origin, no trailing slash. Used for canonical URLs, sitemaps, emails.
NEXT_PUBLIC_SITE_URL=https://thedailycircuit.example
CONTACT_EMAIL=
CORRECTIONS_EMAIL=

# ── Security ────────────────────────────────────────────────────────────────
# 32+ random characters: `openssl rand -base64 48`
SESSION_SECRET=
# Shared secret the worker uses to call the web app's internal endpoints.
INTERNAL_JOB_SECRET=
# Worker → web base URL for cache revalidation (usually = NEXT_PUBLIC_SITE_URL).
WEB_INTERNAL_URL=

# First administrator (used once by `npm run admin:create -w @tdc/core`).
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
ADMIN_NAME=Administrator

# ── Claude (Anthropic) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Writing + research. Default: Claude Sonnet 5.5.
CLAUDE_WRITER_MODEL=claude-sonnet-5-5
# Classification, triage and fact-check pass. Default: Claude Haiku 5.5.
CLAUDE_CLASSIFIER_MODEL=claude-haiku-5-5

# Provider for writing/checking: "anthropic" (default) or "gemini" (free tier works).
LLM_PROVIDER=anthropic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Minimum milliseconds between Gemini requests (free-tier per-minute limits).
GEMINI_MIN_INTERVAL_MS=7000

# ── Email ───────────────────────────────────────────────────────────────────
# "log" prints emails to the logs (development). "resend" sends via Resend.
EMAIL_TRANSPORT=log
RESEND_API_KEY=
# Must be a sender on a domain verified with your email provider.
EMAIL_FROM=The Daily Circuit <newsroom@thedailycircuit.example>
# Comma-separated recipients for the 9 PM report and failure alerts.
ADMIN_ALERT_EMAILS=

# ── Market data ─────────────────────────────────────────────────────────────
# "none" (default) or "eodhd". Exchange data may not be republished without a licence.
MARKET_DATA_PROVIDER=none
EODHD_API_TOKEN=
# Set to "true" only after confirming your plan permits public redistribution.
MARKET_DATA_REDISTRIBUTION_LICENSED=false

# ── Analytics & search ──────────────────────────────────────────────────────
# GA4 measurement ID (G-XXXXXXXXXX). Loaded only after visitor consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console HTML-tag verification token (content value only).
GOOGLE_SITE_VERIFICATION=

# ── Worker ──────────────────────────────────────────────────────────────────
PORT=8080
WORKER_ID=
LOG_LEVEL=info
